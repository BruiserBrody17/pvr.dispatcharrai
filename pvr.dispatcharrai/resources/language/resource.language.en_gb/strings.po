msgstr ""

msgctxt "#30000"
msgid "Connection"
msgstr ""

msgctxt "#30001"
msgid "Dispatcharr host / IP address"
msgstr ""

msgctxt "#30002"
msgid "Hostname or IP address of your Dispatcharr server, without http:// or a port."
msgstr ""

msgctxt "#30003"
msgid "Port"
msgstr ""

msgctxt "#30004"
msgid "Dispatcharr's web/API port (default 9191)."
msgstr ""

msgctxt "#30005"
msgid "Use HTTPS"
msgstr ""

msgctxt "#30006"
msgid "Enable if Dispatcharr is served over HTTPS (e.g. behind a reverse proxy)."
msgstr ""

msgctxt "#30007"
msgid "Username"
msgstr ""

msgctxt "#30008"
msgid "Dispatcharr account username used to obtain an API token."
msgstr ""

msgctxt "#30009"
msgid "Password"
msgstr ""

msgctxt "#30010"
msgid "Dispatcharr account password used to obtain an API token."
msgstr ""

msgctxt "#30011"
msgid "Verify SSL certificate"
msgstr ""

msgctxt "#30012"
msgid "Disable only if you use a self-signed certificate you trust."
msgstr ""

msgctxt "#30013"
msgid "Connection timeout (seconds)"
msgstr ""

msgctxt "#30014"
msgid "How long to wait for Dispatcharr to respond before failing a request."
msgstr ""

msgctxt "#30020"
msgid "Live TV / EPG"
msgstr ""

msgctxt "#30021"
msgid "EPG refresh interval (hours)"
msgstr ""

msgctxt "#30022"
msgid "How often to re-download the XMLTV guide from Dispatcharr."
msgstr ""

msgctxt "#30023"
msgid "Channel list refresh interval (hours)"
msgstr ""

msgctxt "#30024"
msgid "How often to re-fetch the channel and group list from Dispatcharr."
msgstr ""

msgctxt "#30025"
msgid "Delay before switching channels (seconds)"
msgstr ""

msgctxt "#30026"
msgid "Off (0) by default. If switching channels fails or times out, first check whether your Dispatcharr host resolves to an unreachable IPv6 address -- that's the far more common cause. Only raise this if a specific Dispatcharr/provider setup genuinely needs a moment between switches."
msgstr ""

msgctxt "#30027"
msgid "Enable live TV pause/rewind (timeshift)"
msgstr ""

msgctxt "#30028"
msgid "Lets you pause, rewind, and fast-forward live channels. Requires the separate inputstream.ffmpegdirect addon (Kodi's official repository) to be installed -- if it isn't, live channels will fail to play, so leave this off until it is. The buffer is recorded to local disk on this device (managed by ffmpegdirect's own settings), not held on the Dispatcharr server -- it does not persist across a Kodi restart or follow you to another device."
msgstr ""

msgctxt "#30035"
msgid "Recordings"
msgstr ""

msgctxt "#30036"
msgid "Enable in-progress recording playback (experimental)"
msgstr ""

msgctxt "#30037"
msgid "Lets you play a recording while Dispatcharr is still actively writing it, by routing it through the separate inputstream.ffmpegdirect addon (Kodi's official repository) instead of this addon's normal recording playback -- it must be installed, or playback will fail. Experimental: unlike completed recordings, this hasn't seen the same amount of real-world use. Leave off to keep the existing behaviour of waiting for a recording to finish before playing it."
msgstr ""

msgctxt "#30038"
msgid "Recordings/timers refresh interval (minutes)"
msgstr ""

msgctxt "#30039"
msgid "How often to ask Kodi to re-check its recordings and timers list on its own, without waiting for a local action (like starting or deleting a recording from this Kodi) to prompt it. Without this, a change made another way -- from a different Kodi install sharing this Dispatcharr account, directly through Dispatcharr itself, or a recording finishing on its own with nothing local to react to it -- would only ever show up after restarting Kodi."
msgstr ""

msgctxt "#30040"
msgid "Enable real-time recording/timer updates (experimental)"
msgstr ""

msgctxt "#30041"
msgid "Connects directly to Dispatcharr's own real-time update feed (the same one its own web interface uses -- no extra setup on the Dispatcharr side needed) so a change shows up in Kodi immediately instead of waiting for the refresh interval above. That interval keeps running as a fallback even with this on, in case the connection can't be made or drops and stays down. Experimental: this is new, hand-written networking code that hasn't seen the same real-world use as the rest of this addon -- leave off if you'd rather stick with the plain refresh interval."
msgstr ""

msgctxt "#30043"
msgid "Play live (follows the recording as it grows, no seek/rewind)"
msgstr ""

msgctxt "#30045"
msgid "Now press Play to start this recording live"
msgstr ""

msgctxt "#30046"
msgid "This recording has already finished -- nothing to switch to live"
msgstr ""

msgctxt "#30047"
msgid "Improve catch-up seek reliability (experimental)"
msgstr ""

msgctxt "#30048"
msgid "Routes catch-up/archive playback (play from guide) through the separate inputstream.ffmpegdirect addon (Kodi's official repository) instead of Kodi's own built-in seeking, which can be imprecise for raw MPEG-TS over HTTP. Experimental -- requires inputstream.ffmpegdirect to be installed, or catch-up playback will fail outright with this on. Leave off to use Kodi's default catch-up playback."
msgstr ""

msgctxt "#30030"
msgid "Advanced"
msgstr ""

msgctxt "#30031"
msgid "Enable verbose debug logging"
msgstr ""

msgctxt "#30032"
msgid "Logs full request/response details to the Kodi log. Leave off for normal use."
msgstr ""

msgctxt "#30033"
msgid "Dispatcharr API key"
msgstr ""

msgctxt "#30034"
msgid "Generated automatically on first connection and used only to play recordings, which Dispatcharr requires authentication for. Leave blank to have one generated for you -- only set this manually if you need to replace it (e.g. it was revoked or regenerated elsewhere), since regenerating one replaces the previous key for the whole account."
msgstr ""
